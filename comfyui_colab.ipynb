   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Launch ComfyUI"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title Launch ComfyUI { display-mode: \"form\" }\n",
    "\n",
    "import subprocess\n",
    "import threading\n",
    "import time\n",
    "from google.colab import output\n",
    "from IPython.display import IFrame\n",
    "\n",
    "PORT = 8188  #@param {type:\"integer\"}\n",
    "LOW_VRAM = True  #@param {type:\"boolean\"}\n",
    "\n",
    "# Build command\n",
    "cmd = [\n",
    "    \"python\", \"main.py\",\n",
    "    \"--listen\", \"0.0.0.0\",\n",
    "    \"--port\", str(PORT),\n",
    "    \"--output-directory\", OUTPUT_DIR\n",
    "]\n",
    "\n",
    "if LOW_VRAM:\n",
    "    cmd.extend([\"--lowvram\", \"--preview-method\", \"auto\"])\n",
    "\n",
    "# Start ComfyUI in background\n",
    "def run_comfyui():\n",
    "    subprocess.run(cmd)\n",
    "\n",
    "thread = threading.Thread(target=run_comfyui, daemon=True)\n",
    "thread.start()\n",
    "\n",
    "# Wait for server to start\n",
    "print(\"Starting ComfyUI...\")\n",
    "time.sleep(10)\n",
    "\n",
    "# Get public URL\n",
    "try:\n",
    "    from google.colab.output import eval_js\n",
    "    url = eval_js(f\"google.colab.kernel.proxyPort({PORT})\")\n",
    "    print(f\"\\n✅ ComfyUI is running!\")\n",
    "    print(f\"\\n🔗 Click to open: {url}\")\n",
    "    print(f\"\\nOr use local URL: http://localhost:{PORT}\")\n",
    "except:\n",
    "    print(f\"\\n✅ ComfyUI is running at http://localhost:{PORT}\")"
   ]
  },
