   "source": [
    "## 3. Install Our Custom Nodes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title Clone Custom Nodes Repository { display-mode: \"form\" }\n",
    "\n",
    "# Clone our custom nodes\n",
    "!git clone https://github.com/your-repo/comfyui-local-runner.git /tmp/comfyui-local-runner\n",
    "\n",
    "# Copy custom nodes\n",
    "!cp -r /tmp/comfyui-local-runner/custom_nodes/* custom_nodes/\n",
    "\n",
    "# Install custom node requirements\n",
    "!for req in custom_nodes/*/requirements.txt; do\n",
    "    if [ -f \"$req\" ]; then\n",
    "        echo \"Installing requirements for $req\"\n",
    "        pip install -r \"$req\"\n",
    "    fi\n",
    "done\n",
    "\n",
    "print(\"\\n✅ Custom nodes installed!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Download Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title Download Essential Models { display-mode: \"form\" }\n",
    "\n",
    "import os\n",
    "import gdown\n",
    "from huggingface_hub import hf_hub_download\n",
    "\n",
    "# Create directories\n",
    "os.makedirs(\"models/checkpoints\", exist_ok=True)\n",
    "os.makedirs(\"models/controlnet\", exist_ok=True)\n",
    "os.makedirs(\"models/loras\", exist_ok=True)\n",
    "os.makedirs(\"models/ultralytics/bbox\", exist_ok=True)\n",
    "os.makedirs(\"models/sams\", exist_ok=True)\n",
    "\n",
    "# Download SDXL Base\n",
    "!wget -c https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/resolve/main/sd_xl_base_1.0.safetensors -P models/checkpoints/\n",
    "\n",
    "# Download ControlNet OpenPose\n",
    "!wget -c https://huggingface.co/thibaud/controlnet-openpose-sdxl-1.0/resolve/main/OpenPoseXL2.safetensors -P models/controlnet/\n",
    "\n",
    "# Download YOLO Face Model\n",
    "!wget -c https://huggingface.co/Bingsu/adetailer/resolve/main/face_yolov8m.pt -P models/ultralytics/bbox/\n",
    "\n",
    "# Download YOLO Hand Model\n",
    "!wget -c https://huggingface.co/Bingsu/adetailer/resolve/main/hand_yolov8s.pt -P models/ultralytics/bbox/\n",
    "\n",
    "print(\"\\n✅ Models downloaded!\")"
   ]
  },
