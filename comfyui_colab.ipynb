   "source": [
    "## 9. CivitAI Integration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title CivitAI Model Search & Download { display-mode: \"form\" }\n",
    "\n",
    "import requests\n",
    "import json\n",
    "\n",
    "CIVITAI_TOKEN = \"\"  #@param {type:\"string\"}\n",
    "SEARCH_QUERY = \"anime style\"  #@param {type:\"string\"}\n",
    "MODEL_TYPE = \"LORA\"  #@param [\"Checkpoint\", \"LORA\", \"TextualInversion\", \"ControlNet\"]\n",
    "\n",
    "def search_civitai(query, model_type, token=\"\"):\n",
    "    url = \"https://civitai.com/api/v1/models\"\n",
    "    params = {\n",
    "        \"query\": query,\n",
    "        \"types\": model_type,\n",
    "        \"limit\": 10,\n",
    "        \"sort\": \"Highest Rated\"\n",
    "    }\n",
    "    headers = {}\n",
    "    if token:\n",
    "        headers[\"Authorization\"] = f\"Bearer {token}\"\n",
    "    \n",
    "    response = requests.get(url, params=params, headers=headers)\n",
    "    return response.json()\n",
    "\n",
    "# Search\n",
    "if SEARCH_QUERY:\n",
    "    print(f\"Searching for: {SEARCH_QUERY}\")\n",
    "    results = search_civitai(SEARCH_QUERY, MODEL_TYPE, CIVITAI_TOKEN)\n",
    "    \n",
    "    print(\"\\nFound models:\")\n",
    "    for i, item in enumerate(results.get(\"items\", [])[:5]):\n",
    "        print(f\"\\n{i+1}. {item['name']}\")\n",
    "        print(f\"   Type: {item.get('type', 'N/A')}\")\n",
    "        print(f\"   Stats: {item.get('stats', {})}\")\n",
    "        print(f\"   Versions: {len(item.get('modelVersions', []))}\")"
   ]
  },
