   "source": [
    "## 2. Install ComfyUI & Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title Install ComfyUI { display-mode: \"form\" }\n",
    "\n",
    "# Clone repository\n",
    "!git clone https://github.com/comfyanonymous/ComfyUI.git\n",
